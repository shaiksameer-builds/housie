# Database configuration (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Public Socket.IO Server URL (frontend connects to this)
# In production on Render/Railway, set to e.g. "https://your-socket-server.onrender.com"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Web App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Ports
SOCKET_PORT=3001
PORT=3000
NODE_ENV=development

# Unified Deployment (Optional): Set to true to serve both Next.js and Socket.IO on a single PORT (e.g. Render / Railway / Fly.io single container)
SERVE_NEXT=false
